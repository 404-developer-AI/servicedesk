<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- 9.2.x moves the sanitizer onto AngleSharp 1.7.x, past the 1.5.0 fix
         for GHSA-pgww-w46g-26qg (mXSS via MathML annotation-xml). AngleSharp
         is the parser INSIDE the sanitizer, so a parser bug there is a
         sanitizer bypass — keep this package current. -->
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="libphonenumber-csharp" Version="8.13.45" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.10" />
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.Graph" Version="5.105.0" />
    <!-- Pin Kiota.Abstractions ≥ 1.22.0 to patch GHSA-7j59-v9qr-6fq9
         (RedirectHandler leaks Cookie/Proxy-Authorization headers on
         cross-host redirect). Microsoft.Graph 5.105.0 transitively
         resolves to 1.21.1 which is still vulnerable; this direct ref
         forces the fixed version. Drop the override once Microsoft.Graph
         ships a release that pulls 1.22.0+ on its own. -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
    <PackageReference Include="Azure.Identity" Version="1.12.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.18.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.18.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <!-- PdfSharpCore still resolves SixLabors.ImageSharp 1.0.4, which carries
         three High advisories in its image decoders. Pin the last patched
         2.x (Apache-2.0; 3.x changed license) to override the transitive
         resolution. Safe because our PDF builders only use the text APIs
         (XFont/XGraphics.DrawString) — no XImage/raster load path — and the
         PDF test suite exercises exactly that. Drop this override once
         PdfSharpCore ships against a patched ImageSharp itself. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <!-- Pulled in transitively by Microsoft.IdentityModel.* and Microsoft.Graph.
         Pinning 8.0.3 (last on the 8.x track that patches GHSA-37gx-xxp4-5rgx
         and GHSA-w3x6-4m5h-cxqf — both fixed there). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
    <PackageReference Include="Serilog" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Servicedesk.Domain\Servicedesk.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Servicedesk.Api.Tests" />
  </ItemGroup>

</Project>
