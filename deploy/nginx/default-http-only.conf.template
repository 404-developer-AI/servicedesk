# default-http-only.conf.template — non-TLS variant for the SSL=no install.sh
# path. Used in dev-demos, VPN-only deployments, or behind a trusted external
# TLS terminator. install.sh (v0.0.15) copies this to the template mount when
# the admin declines Let's Encrypt.
#
# Same header-ownership rule as the TLS variant: nginx owns zero response
# headers here (no HSTS without TLS) — all security headers come from the app.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Hide nginx version in Server: response header + default error pages.
server_tokens off;

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;

# v0.1.24 — access log with timings (Settings → Performance → Server). Same
# content as the default "combined" format minus the query string (it can
# carry tokens), plus request time, upstream (app) time and connect time:
# rt − urt is time spent between nginx and the browser. Read on the host with
# `docker compose logs nginx`.
log_format sd_timing '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                     'rt=$request_time urt=$upstream_response_time uct=$upstream_connect_time';
access_log /var/log/nginx/access.log sd_timing;

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml+rss application/xml text/javascript;
    gzip_min_length 1024;
    # v0.1.25 — also compress when the request arrived through a proxy
    # (corporate proxies add a Via header; nginx then skips gzip by
    # default) and a slightly higher level: ticket JSON is 200-800 KB
    # uncompressed and compresses ~10x.
    gzip_proxied any;
    gzip_comp_level 5;

    client_max_body_size 50M;

    # Agent auth + customer-portal auth (v0.1.0) share the nginx-level
    # burst limit; the app applies its own per-IP limiters on top.
    location ~ ^/api/(auth|portal/auth)/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hubs/ {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
