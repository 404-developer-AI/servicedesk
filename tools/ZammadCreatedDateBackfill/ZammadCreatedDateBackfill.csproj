<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone, one-time backfill tool. Deliberately NOT part of
    Servicedesk.slnx and NOT copied by the Dockerfile.

    It references NO production code and needs NO database connection: it
    talks only to the (internet-facing) Zammad API, so it runs from any
    workstation with .NET 8. Its only output is a reviewable, idempotent
    .sql file that the operator inspects and applies against the database
    by hand (e.g. on the server where Postgres is reachable).
    Build/run it by pointing dotnet at this csproj.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZammadCreatedDateBackfill</RootNamespace>
    <AssemblyName>zammad-created-date-backfill</AssemblyName>
  </PropertyGroup>

</Project>
